// fuzzy_c_means_model.dot — Fuzzy C-Means (FCM) Dataflow
digraph FCM_Model {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];

    Input [label="Input: 10-Dimensional Normalized Features", fillcolor="#dbeafe", color="#2563eb"];
    Init [label="Random Fuzzy Membership Matrix u_ik in [0, 1]\nsum_k u_ik = 1 for each sentence trial", fillcolor="#fef3c7", color="#d97706"];
    Loop [label="Fuzzy Objective Minimization (m = 1.3)\n1. Update Centers: c_k = sum(u_ik^m * x_i) / sum(u_ik^m)\n2. Update Memberships: u_ik = 1 / sum( ||x_i - c_k|| / ||x_i - c_j|| )^(2/(m-1))", fillcolor="#e0e7ff", color="#4f46e5"];
    Output [label="Outputs:\n- Continuous Soft Membership Degrees u_ik in [0, 1]\n- Hard Prediction Label: argmax_k u_ik\n- Centroids c_k [CHAMPION MODEL]", fillcolor="#dcfce7", color="#16a34a", penwidth=2.0];

    Input -> Init -> Loop -> Output;
}
